#include "opcodes.h"

#include "common.h"
#include "instructions.h"

#include <stdarg.h>

static void assembler_error(const struct token *t, const char *fmt, ...)
{
	va_list args;
	va_start(args, fmt);

	fprintf(stderr, "assembler: line %zu, line%zu: ", t->line, t->col);
	vfprintf(stderr, fmt, args);
	fprintf(stderr, "\n");

	va_end(args);
}

static bool expect_operand_count(const struct stmt *stmt, const size_t expected)
{
	if (stmt->noperands == expected)
		return true;

	assembler_error(&stmt->instruction, "instruction requires %zu %s, got %zu %s",
		expected, (expected == 1) ? "operand" : "operands",
		stmt->noperands, (stmt->noperands == 1) ? "operand" : "operands" );

	return false;
}

static bool expect_register(const struct token *operand)
{
	if (operand->type == TOKEN_REGISTER)
		return true;
	
	assembler_error(operand, "expected register");
	
	return false;
}

static bool expect_number_literal(const struct token *operand)
{
	if (operand->type == TOKEN_NUMBER)
		return true;
	
	assembler_error(operand, "expected number literal");
	
	return false;
}

static bool expect_valid_address(const struct token *operand)
{
	if (!expect_number_literal(operand))
		return false;

	const uint16_t addr = operand->as.num;
	if (addr <= 0x0FFF)
		return true;

	assembler_error(operand, "invalid memory address");

	return false;
}

static bool expect_valid_value(const struct token *operand)
{
	if (operand->type == TOKEN_REGISTER)
		return true;
	
	const uint16_t val = operand->as.num;
	if (val <= 0xFF)
		return true;

	assembler_error(operand, "invalid operand value");

	return false;
}

/*
	ins
	ins addr
	ins reg
	ins reg val
	ins [reg]
*/

uint16_t opcode_from_statement(const struct stmt *stmt)
{
	const enum instruction ins = stmt->instruction.as.ins;
	switch (ins) {
	case INS_SYS: {
		if (!expect_operand_count(stmt, 1))
			return OPCODE_INVALID;

		const struct token *operand = &stmt->operands[0];
		if (!expect_valid_address(operand))
			return OPCODE_INVALID;

		return (0x0000) & operand->as.num;
	} break;

	case INS_CLS: {
		if (!expect_operand_count(stmt, 0))
			return OPCODE_INVALID;

		return (0x00E0);
	} break;

	case INS_RET: {
		if (!expect_operand_count(stmt, 0))
			return OPCODE_INVALID;

		return (0x00EE);
	} break;

	case INS_JP: {
		if (!expect_operand_count(stmt, 1))
			return OPCODE_INVALID;

		const struct token *operand = &stmt->operands[0];
		if (!expect_valid_address(operand))
			return OPCODE_INVALID;

		return (0x1000) | operand->as.num;
	} break;

	case INS_CALL: {
		if (!expect_operand_count(stmt, 1))
			return OPCODE_INVALID;

		const struct token *operand = &stmt->operands[0];
		if (!expect_valid_address(operand))
			return OPCODE_INVALID;

		return (0x2000) | operand->as.num;
	} break;

	case INS_SE: {
		if (!expect_operand_count(stmt, 2))
			return OPCODE_INVALID;

		const struct token *operand0 = &stmt->operands[0];
		const struct token *operand1 = &stmt->operands[1];

		if (!expect_register(operand0))
			return OPCODE_INVALID;

		if (!expect_valid_value(operand1))
			return OPCODE_INVALID;

		if (operand1->type == TOKEN_NUMBER)
			return (0x3000) | ((uint16_t)operand0->as.reg << 8) | (operand1->as.num);
		else
			return (0x5000) | ((uint16_t)operand0->as.reg << 8) | ((uint16_t)operand1->as.reg << 4);
	} break;

	case INS_SNE: {
		if (!expect_operand_count(stmt, 2))
			return OPCODE_INVALID;

		const struct token *operand0 = &stmt->operands[0];
		const struct token *operand1 = &stmt->operands[1];

		if (!expect_register(operand0))
			return OPCODE_INVALID;

		if (!expect_valid_value(operand1))
			return OPCODE_INVALID;

		if (operand1->type == TOKEN_NUMBER)
			return (0x3000) | ((uint16_t)operand0->as.reg << 8) | (operand1->as.num);
		else
			return (0x5000) | ((uint16_t)operand0->as.reg << 8) | ((uint16_t)operand1->as.reg << 4);
	} break;

	case INS_LD: {
		return OPCODE_INVALID;
	} break;

	case INS_ADD: {
		return OPCODE_INVALID;
	} break;

	case INS_SUB: {
		return OPCODE_INVALID;
	} break;

	case INS_SUBN: {
		return OPCODE_INVALID;
	} break;

	case INS_OR: {
		return OPCODE_INVALID;
	} break;

	case INS_XOR: {
		return OPCODE_INVALID;
	} break;

	case INS_AND: {
		return OPCODE_INVALID;
	} break;

	case INS_SHR: {
		return OPCODE_INVALID;
	} break;

	case INS_SHL: {
		return OPCODE_INVALID;
	} break;

	case INS_RND: {
		return OPCODE_INVALID;
	} break;

	case INS_SKP: {
		return OPCODE_INVALID;
	} break;

	case INS_SKNP: {
		return OPCODE_INVALID;
	} break;

	default:	return OPCODE_INVALID;
	}
}
